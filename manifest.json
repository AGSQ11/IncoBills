{
  "manifest_version": 2,
  "name": "IncoBills",
  "description": "__MSG_extDescription__",
  "version": "1.2.0",
  "author": "ServerSpan",
  "homepage_url": "https://github.com/serverspan/incobills",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "incobills@serverspan.com",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "background": {
    "scripts": [
      "shared/constants.js",
      "shared/i18n.js",
      "shared/text.js",
      "shared/fiscal.js",
      "shared/storage.js",
      "shared/saga-constants.js",
      "background/http.js",
      "background/llm.js",
      "background/classifiers/keywords.js",
      "background/sender-rules.js",
      "background/classifier.js",
      "background/folder-manager.js",
      "background/history.js",
      "background/saga/company-registry.js",
      "background/saga/anaf.js",
      "background/saga/efactura.js",
      "background/saga/pdf-extractor.js",
      "background/saga/validator.js",
      "background/saga/xml-generator.js",
      "background/saga/saga-export.js",
      "background/email-monitor.js",
      "background/menus.js",
      "background/background.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    },
    "default_title": "IncoBills",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "messagesRead",
    "messagesMove",
    "accountsRead",
    "accountsFolders",
    "menus",
    "notifications",
    "storage",
    "downloads",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://webservicesp.anaf.ro/*"
  ],
  "optional_permissions": [
    "*://*/*"
  ]
}
